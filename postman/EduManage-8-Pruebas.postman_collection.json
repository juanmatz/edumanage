{
  "info": {
    "_postman_id": "b7f1c2d4-8a3e-4f6b-9c1d-2e5a7b9c0d11",
    "name": "EduManage - 8 Pruebas (Entrega)",
    "description": "Colección corta para la entrega: 8 pruebas sobre el recurso Grades (CRUD, validación y casos negativos).\n\nOrden de ejecución: 1 a 8. Usar el environment 'EduManage Local'.\n\nNo requiere roles ni datos previos: solo la aplicación levantada y la base de datos creada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. POST Crear grado",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Reinicia el ID para que cada ejecución sea independiente",
              "pm.environment.set('gradeId', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 1: el grado se crea con status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Prueba 1: la respuesta trae un ID generado', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.environment.set('gradeId', body.id);",
              "});",
              "",
              "pm.test('Prueba 1: los datos enviados se guardan correctamente', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.gradeName).to.eql('Primero A');",
              "    pm.expect(body.maxCapacity).to.eql(30);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gradeName\": \"Primero A\",\n  \"maxCapacity\": 30\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/grades",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades"
          ]
        },
        "description": "Crea un grado y guarda su ID en la variable de entorno gradeId."
      },
      "response": []
    },
    {
      "name": "2. GET Listar grados",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 2: el listado responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Prueba 2: la respuesta es un array no vacío', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "    pm.expect(body.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test('Prueba 2: el listado incluye el grado creado', function () {",
              "    const body = pm.response.json();",
              "    const id = pm.environment.get('gradeId');",
              "    pm.expect(body.some(function (g) { return String(g.id) === String(id); })).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grades",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades"
          ]
        },
        "description": "Verifica que el grado creado aparezca en el listado."
      },
      "response": []
    },
    {
      "name": "3. GET Grado por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 3: el grado se consulta con status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Prueba 3: el ID consultado coincide', function () {",
              "    const body = pm.response.json();",
              "    const id = pm.environment.get('gradeId');",
              "    pm.expect(String(body.id)).to.eql(String(id));",
              "});",
              "",
              "pm.test('Prueba 3: el grado tiene nombre y capacidad', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.gradeName).to.be.a('string').and.not.empty;",
              "    pm.expect(body.maxCapacity).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grades/{{gradeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades",
            "{{gradeId}}"
          ]
        },
        "description": "Consulta el grado por el ID guardado en la prueba 1."
      },
      "response": []
    },
    {
      "name": "4. PUT Actualizar grado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 4: la actualización responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Prueba 4: el nombre fue actualizado', function () {",
              "    pm.expect(pm.response.json().gradeName).to.eql('Primero B');",
              "});",
              "",
              "pm.test('Prueba 4: la capacidad fue actualizada', function () {",
              "    pm.expect(pm.response.json().maxCapacity).to.eql(35);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gradeName\": \"Primero B\",\n  \"maxCapacity\": 35\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/grades/{{gradeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades",
            "{{gradeId}}"
          ]
        },
        "description": "Actualiza nombre y capacidad del grado creado."
      },
      "response": []
    },
    {
      "name": "5. POST Grado inválido (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 5: un grado inválido responde 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Prueba 5: se informa el error del nombre', function () {",
              "    pm.expect(pm.response.json().fieldErrors).to.have.property('gradeName');",
              "});",
              "",
              "pm.test('Prueba 5: se informa el error de la capacidad', function () {",
              "    pm.expect(pm.response.json().fieldErrors).to.have.property('maxCapacity');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gradeName\": \"\",\n  \"maxCapacity\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/grades",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades"
          ]
        },
        "description": "Caso negativo: nombre vacío y capacidad cero deben devolver 400 con fieldErrors."
      },
      "response": []
    },
    {
      "name": "6. GET Grado inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 6: un ID inexistente responde 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Prueba 6: el cuerpo indica el status 404', function () {",
              "    pm.expect(pm.response.json().status).to.eql(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grades/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades",
            "999999"
          ]
        },
        "description": "Caso negativo: consultar un grado que no existe."
      },
      "response": []
    },
    {
      "name": "7. DELETE Eliminar grado (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 7: la eliminación responde 204', function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.test('Prueba 7: la respuesta no tiene cuerpo', function () {",
              "    pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grades/{{gradeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades",
            "{{gradeId}}"
          ]
        },
        "description": "Elimina el grado creado para dejar la base limpia."
      },
      "response": []
    },
    {
      "name": "8. GET Grado eliminado (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prueba 8: el grado eliminado ya no existe (404)', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Prueba 8: el cuerpo indica el status 404', function () {",
              "    pm.expect(pm.response.json().status).to.eql(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grades/{{gradeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "grades",
            "{{gradeId}}"
          ]
        },
        "description": "Verifica que el DELETE de la prueba 7 fue efectivo."
      },
      "response": []
    }
  ]
}
